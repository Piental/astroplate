---
import Base from "@/layouts/Base.astro";
import ServicesGrid from "@/components/ServicesGrid.astro";
import SEOHead from "@/components/SEOHead.astro";
import config from "@/config/config.json";
import { getCollection } from "astro:content";

const { default_language } = config.settings;
const lang = default_language;

// Get services collection for Polish
const allServices = await getCollection("services");
const services = allServices
  .filter((service) => service.id.startsWith("polish/") && !service.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
---

<Base title="Oferta" lang={lang}>
  <SEOHead
    slot="head"
    title="Nasza Oferta - Meble na wymiar"
    description="Oferujemy meble na wymiar: kuchnie, szafy, garderoby, zabudowy meblowe. Wysoka jakość i indywidualne projekty."
    lang={lang}
  />

  <section class="section pt-14">
    <div class="container">
      <div class="text-center mb-12">
        <h1 class="h2 mb-4">Nasza Oferta</h1>
        <p class="text-lg text-text dark:text-darkmode-text">
          Tworzymy meble na wymiar dopasowane do Twoich potrzeb
        </p>
      </div>
      <ServicesGrid
        services={services}
        baseUrl="/oferta"
        ctaText="Dowiedz się więcej"
      />
    </div>
  </section>
</Base>
