---
import Base from "@/layouts/Base.astro";
import SEOHead from "@/components/SEOHead.astro";
import ImageMod from "@/components/ImageMod.astro";
import CallToActionComp from "@/components/CallToAction.astro";
import StickyCallButton from "@/components/StickyCallButton.astro";
import config from "@/config/config.json";
import { getCollection } from "astro:content";
import { render } from "astro:content";

const { default_language } = config.settings;
const lang = default_language;

export async function getStaticPaths() {
  const allServices = await getCollection("services");
  const polishServices = allServices.filter((service) =>
    service.id.startsWith("polish/")
  );

  return polishServices.map((service) => ({
    params: { slug: service.data.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const { Content } = await render(service);
---

<Base title={service.data.title} lang={lang}>
  <SEOHead
    slot="head"
    title={service.data.title}
    description={service.data.excerpt}
    image={service.data.image}
    lang={lang}
  />

  <section class="section pt-14">
    <div class="container">
      <div class="row justify-center">
        <article class="lg:col-10">
          {
            service.data.image && (
              <div class="mb-10">
                <ImageMod
                  src={service.data.image}
                  alt={service.data.title}
                  width={1200}
                  height={600}
                  format="webp"
                  class="w-full rounded"
                />
              </div>
            )
          }
          <h1 class="h2 mb-4">{service.data.title}</h1>
          <div class="content mb-10">
            <Content />
          </div>
          <div class="mt-8">
            <a href="/oferta" class="btn btn-outline-primary">
              ← Powrót do oferty
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <CallToActionComp
    title="Zainteresowany tą usługą?"
    description="Skontaktuj się z nami, aby omówić szczegóły Twojego projektu"
    buttonText="Zadzwoń teraz"
  />
  <StickyCallButton />
</Base>
