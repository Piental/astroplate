---
import Base from "@/layouts/Base.astro";
import PortfolioGrid from "@/components/PortfolioGrid.astro";
import PortfolioFilters from "@/helpers/PortfolioFilters";
import SEOHead from "@/components/SEOHead.astro";
import { getCollection } from "astro:content";

const lang = "en";

// Get projects collection for English
const allProjects = await getCollection("projects");
const projects = allProjects
  .filter((project) => project.id.startsWith("english/") && !project.data.draft)
  .sort((a, b) => (b.data.year || 0) - (a.data.year || 0));

// Extract unique categories
const allCategories = projects.flatMap((p) => p.data.categories);
const uniqueCategories = [...new Set(allCategories)];
---

<Base title="Our Projects" lang={lang}>
  <SEOHead
    slot="head"
    title="Our Projects - Portfolio of Completed Work"
    description="See our completed projects: custom kitchens, wardrobes, walk-in closets and built-in furniture."
    lang={lang}
  />

  <section class="section pt-14">
    <div class="container">
      <div class="text-center mb-12">
        <h1 class="h2 mb-4">Our Projects</h1>
        <p class="text-lg text-text dark:text-darkmode-text">
          See our completed projects
        </p>
      </div>

      {uniqueCategories.length > 0 && (
        <PortfolioFilters
          categories={uniqueCategories}
          allLabel="All"
          client:idle
        />
      )}

      <PortfolioGrid
        projects={projects}
        baseUrl="/en/projects"
        ctaText="View more"
        yearLabel="Year:"
      />
    </div>
  </section>
</Base>
