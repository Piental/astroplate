---
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ServicesGrid from "@/components/ServicesGrid.astro";
import SEOHead from "@/components/SEOHead.astro";
import { getCollection } from "astro:content";

const lang = "en";

// Get services collection for English
const allServices = await getCollection("services");
const services = allServices
  .filter((service) => service.id.startsWith("english/") && !service.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
---

<Base title="Our Offer" lang={lang}>
  <SEOHead
    slot="head"
    title="Our Offer - Custom Furniture"
    description="We offer custom furniture: kitchens, wardrobes, walk-in closets, built-in furniture. High quality and individual designs."
    lang={lang}
  />

  <div class="border-t border-border py-4 dark:border-darkmode-border">
    <div class="container">
      <Breadcrumbs className="text-sm" />
    </div>
  </div>
  <section class="section pt-14">
    <div class="container">
      <div class="text-center mb-12">
        <h1 class="h2 mb-4">Our Offer</h1>
        <p class="text-lg text-text dark:text-darkmode-text">
          We create custom furniture tailored to your needs
        </p>
      </div>
      <ServicesGrid
        services={services}
        baseUrl="/en/offer"
        ctaText="Learn more"
      />
    </div>
  </section>
</Base>
