---
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import SEOHead from "@/components/SEOHead.astro";
import ImageMod from "@/components/ImageMod.astro";
import ProjectGallery from "@/helpers/ProjectGallery";
import CallToActionComp from "@/components/CallToAction.astro";
import StickyCallButton from "@/components/StickyCallButton.astro";
import { getCollection } from "astro:content";
import { render } from "astro:content";

const lang = "en";

export async function getStaticPaths() {
  const allProjects = await getCollection("projects");
  const englishProjects = allProjects.filter((project) =>
    project.id.startsWith("english/")
  );

  return englishProjects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Base title={project.data.title} lang={lang}>
  <SEOHead
    slot="head"
    title={project.data.title}
    description={`Realization: ${project.data.title}. Completed in ${project.data.year || 'our portfolio'}.`}
    image={project.data.cover}
    lang={lang}
  />

  <div class="border-t border-border py-4 dark:border-darkmode-border">
    <div class="container">
      <Breadcrumbs className="text-sm" />
    </div>
  </div>
  <section class="section pt-14">
    <div class="container">
      <div class="row justify-center">
        <article class="lg:col-10">
          {
            project.data.cover && (
              <div class="mb-10">
                <ImageMod
                  src={project.data.cover}
                  alt={project.data.title}
                  width={1200}
                  height={600}
                  format="webp"
                  class="w-full rounded"
                />
              </div>
            )
          }
          <h1 class="h2 mb-6">{project.data.title}</h1>

          <div class="bg-light dark:bg-darkmode-light p-6 rounded-lg mb-10">
            {project.data.year && (
              <div class="mb-4">
                <strong>Year:</strong> {project.data.year}
              </div>
            )}

            {project.data.materials && (
              <div class="mb-4">
                <strong>Materials:</strong> {project.data.materials}
              </div>
            )}

            {project.data.time_to_complete && (
              <div class="mb-4">
                <strong>Time to complete:</strong> {project.data.time_to_complete}
              </div>
            )}
          </div>

          <div class="content mb-10">
            <Content />
          </div>

          {project.data.gallery && project.data.gallery.length > 0 && (
            <div class="mb-10">
              <h2 class="h4 mb-6">Gallery</h2>
              <ProjectGallery images={project.data.gallery} client:visible />
            </div>
          )}

          <div class="mt-8">
            <a href="/en/realizations" class="btn btn-outline-primary">
              ← Back to realizations
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <CallToActionComp
    title="Similar project?"
    description="Contact us to discuss your project"
    buttonText="Call now"
  />
  <StickyCallButton label="Call" />
</Base>
