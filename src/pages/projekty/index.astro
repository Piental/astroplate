---
import Base from "@/layouts/Base.astro";
import PortfolioGrid from "@/components/PortfolioGrid.astro";
import PortfolioFilters from "@/helpers/PortfolioFilters";
import SEOHead from "@/components/SEOHead.astro";
import config from "@/config/config.json";
import { getCollection } from "astro:content";

const { default_language } = config.settings;
const lang = default_language;

// Get projects collection for Polish
const allProjects = await getCollection("projects");
const projects = allProjects
  .filter((project) => project.id.startsWith("polish/") && !project.data.draft)
  .sort((a, b) => (b.data.year || 0) - (a.data.year || 0));

// Extract unique categories
const allCategories = projects.flatMap((p) => p.data.categories);
const uniqueCategories = [...new Set(allCategories)];
---

<Base title="Projekty" lang={lang}>
  <SEOHead
    slot="head"
    title="Nasze Projekty - Portfolio Realizacji"
    description="Zobacz nasze zrealizowane projekty: kuchnie, szafy, garderoby i zabudowy meblowe na wymiar."
    lang={lang}
  />

  <section class="section pt-14">
    <div class="container">
      <div class="text-center mb-12">
        <h1 class="h2 mb-4">Nasze Projekty</h1>
        <p class="text-lg text-text dark:text-darkmode-text">
          Zobacz nasze zrealizowane projekty
        </p>
      </div>

      {uniqueCategories.length > 0 && (
        <PortfolioFilters
          categories={uniqueCategories}
          allLabel="Wszystkie"
          client:idle
        />
      )}

      <PortfolioGrid
        projects={projects}
        baseUrl="/projekty"
        ctaText="Zobacz więcej"
        yearLabel="Rok:"
      />
    </div>
  </section>
</Base>
