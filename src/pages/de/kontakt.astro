---
import Base from "@/layouts/Base.astro";
import ContactDetails from "@/components/ContactDetails.astro";
import MapEmbed from "@/components/MapEmbed.astro";
import StickyCallButton from "@/components/StickyCallButton.astro";
import config from "@/config/config.json";
import { getListPage } from "@/lib/contentParser.astro";
import { getTranslations } from "@/lib/utils/languageParser";
import { markdownify } from "@/lib/utils/textConverter";
import { render, type ContentEntryMap } from "astro:content";

const lang = "de";

const contact = await getListPage("contact", lang as keyof ContentEntryMap);
if (contact[0].data.draft) {
  return Astro.redirect("/404");
}

const { Content } = await render(contact[0]);
const data = contact[0].data;
const { title, description, meta_title, image } = data;
const { contact_form_action } = config.params[lang as keyof typeof config.params] ?? config.params.pl;

const translations = await getTranslations(lang as keyof ContentEntryMap);
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
  lang={lang}
>
  <section class="section pt-14">
    <div class="container">
      <div class="row">
        <div class="lg:col-6 mb-8">
          <h1 set:html={markdownify(title)} class="h2 mb-6" />
          <div class="content mb-8">
            <Content />
          </div>

          <ContactDetails
            sectionTitle={data.contact_details_title}
            phone={data.phone}
            email={data.email}
            address={data.address}
            hours={data.hours}
            phoneLabel={data.phone_label}
            emailLabel={data.email_label}
            addressLabel={data.address_label}
            hoursLabel={data.hours_label}
          />
        </div>

        <div class="lg:col-6">
          <div class="bg-light dark:bg-darkmode-light p-8 rounded-lg">
            <h3 class="h4 mb-6">{data.form_title ?? "Kontaktformular"}</h3>
            <form action={contact_form_action} method="POST">
              <div class="mb-6">
                <label for="name" class="form-label">
                  {translations.full_name} <span class="text-red-500">*</span>
                </label>
                <input
                  id="name"
                  name="name"
                  class="form-input"
                  placeholder={translations.full_name_placeholder}
                  type="text"
                  required
                />
              </div>
              <div class="mb-6">
                <label for="email" class="form-label">
                  {translations.working_mail} <span class="text-red-500">*</span>
                </label>
                <input
                  id="email"
                  name="email"
                  class="form-input"
                  placeholder={translations.mail_placeholder}
                  type="email"
                  required
                />
              </div>
              <div class="mb-6">
                <label for="message" class="form-label">
                  {translations.anything_else}
                </label>
                <textarea
                  id="message"
                  name="message"
                  class="form-input"
                  placeholder={translations.contact_message_placeholder}
                  rows="8"
                />
              </div>
              <button type="submit" class="btn btn-primary w-full">
                {translations.submit}
              </button>
            </form>
          </div>
        </div>
      </div>

      <div class="row mt-12">
        <div class="col-12">
          <MapEmbed
            embedUrl={data.embed_url}
            buttonText={data.map_button_text}
            mapTitle={data.map_title}
          />
        </div>
      </div>
    </div>
  </section>

  <StickyCallButton phone={data.phone} label={data.sticky_call_label} />
</Base>
