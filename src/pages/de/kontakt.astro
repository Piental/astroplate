---
import Base from "@/layouts/Base.astro";
import config from "@/config/config.json";
import { getListPage } from "@/lib/contentParser.astro";
import { getTranslations } from "@/lib/utils/languageParser";
import { markdownify } from "@/lib/utils/textConverter";
import { render, type ContentEntryMap } from "astro:content";

const lang = "de";

const contact = await getListPage("contact", lang as keyof ContentEntryMap);
if (contact[0].data.draft) {
  return Astro.redirect("/404");
}

const { Content } = await render(contact[0]);
const { title, description, meta_title, image } = contact[0].data;
const { contact_form_action } = config.params;

const translations = await getTranslations(lang as keyof ContentEntryMap);
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
  lang={lang}
>
  <section class="section-sm">
    <div class="container">
      <div class="row">
        <div class="mx-auto md:col-10 lg:col-6">
          <h2 set:html={markdownify(title)} class="h3 mb-6 text-center" />
          <div class="content mb-6">
            <Content />
          </div>
          <form action={contact_form_action} method="POST">
            <div class="mb-6">
              <label for="name" class="form-label">
                {translations.full_name} <span class="text-red-500">*</span>
              </label>
              <input
                id="name"
                name="name"
                class="form-input"
                placeholder={translations.full_name_placeholder}
                type="text"
                required
              />
            </div>
            <div class="mb-6">
              <label for="email" class="form-label">
                {translations.working_mail} <span class="text-red-500">*</span>
              </label>
              <input
                id="email"
                name="email"
                class="form-input"
                placeholder={translations.mail_placeholder}
                type="email"
                required
              />
            </div>
            <div class="mb-6">
              <label for="message" class="form-label">
                {translations.anything_else}
              </label>
              <textarea
                id="message"
                name="message"
                class="form-input"
                placeholder={translations.contact_message_placeholder}
                rows="8"
              />
            </div>
            <button type="submit" class="btn btn-primary">
              {translations.submit}
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>
</Base>
