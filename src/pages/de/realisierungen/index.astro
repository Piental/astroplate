---
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import PortfolioGrid from "@/components/PortfolioGrid.astro";
import PortfolioFilters from "@/helpers/PortfolioFilters";
import SEOHead from "@/components/SEOHead.astro";
import { getCollection } from "astro:content";
import { getTranslations } from "@/lib/utils/languageParser";
import type { ContentEntryMap } from "astro:content";

const lang = "de";
const translations = await getTranslations(lang as keyof ContentEntryMap);

// Get projects collection for German
const allProjects = await getCollection("projects");
const projects = allProjects
  .filter((project) => project.id.startsWith("german/") && !project.data.draft)
  .sort((a, b) => (b.data.year || 0) - (a.data.year || 0));

// Extract unique categories and build multilingual options
const allCategories = projects.flatMap((p) => p.data.categories);
const uniqueCategories = [...new Set(allCategories)];
const categoryLabels: Record<string, string> = {
  kitchens: translations?.category_kitchens ?? "Küchen",
  wardrobes: translations?.category_wardrobes ?? "Schränke",
  builtins: translations?.category_builtins ?? "Einbaumöbel",
  other: translations?.category_other ?? "Sonstiges",
};
const categoryOptions = uniqueCategories.map((slug) => ({
  slug,
  label: categoryLabels[slug] ?? slug,
}));
---

<Base title="Unsere Realisierungen" lang={lang}>
  <SEOHead
    slot="head"
    title="Unsere Realisierungen - Portfolio"
    description="Sehen Sie unsere Realisierungen: maßgefertigte Küchen, Schränke, Ankleidezimmer und Einbaumöbel."
    lang={lang}
  />

  <div class="border-t border-border py-4 dark:border-darkmode-border">
    <div class="container">
      <Breadcrumbs className="text-sm" />
    </div>
  </div>
  <section class="section pt-14">
    <div class="container">
      <div class="text-center mb-12">
        <h1 class="h2 mb-4">Unsere Realisierungen</h1>
        <p class="text-lg text-text dark:text-darkmode-text">
          Sehen Sie unsere abgeschlossenen Arbeiten
        </p>
      </div>

      {categoryOptions.length > 0 && (
        <PortfolioFilters
          categoryOptions={categoryOptions}
          allLabel={translations?.filter_all ?? "Alle"}
          client:idle
        />
      )}

      <PortfolioGrid
        projects={projects}
        baseUrl="/de/realisierungen"
        ctaText="Mehr ansehen"
        yearLabel="Jahr:"
      />
    </div>
  </section>
</Base>
