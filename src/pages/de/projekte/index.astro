---
import Base from "@/layouts/Base.astro";
import PortfolioGrid from "@/components/PortfolioGrid.astro";
import PortfolioFilters from "@/helpers/PortfolioFilters";
import SEOHead from "@/components/SEOHead.astro";
import { getCollection } from "astro:content";

const lang = "de";

// Get projects collection for German
const allProjects = await getCollection("projects");
const projects = allProjects
  .filter((project) => project.id.startsWith("german/") && !project.data.draft)
  .sort((a, b) => (b.data.year || 0) - (a.data.year || 0));

// Extract unique categories
const allCategories = projects.flatMap((p) => p.data.categories);
const uniqueCategories = [...new Set(allCategories)];
---

<Base title="Unsere Projekte" lang={lang}>
  <SEOHead
    slot="head"
    title="Unsere Projekte - Portfolio der abgeschlossenen Arbeiten"
    description="Sehen Sie unsere abgeschlossenen Projekte: maßgefertigte Küchen, Schränke, Ankleidezimmer und Einbaumöbel."
    lang={lang}
  />

  <section class="section pt-14">
    <div class="container">
      <div class="text-center mb-12">
        <h1 class="h2 mb-4">Unsere Projekte</h1>
        <p class="text-lg text-text dark:text-darkmode-text">
          Sehen Sie unsere abgeschlossenen Projekte
        </p>
      </div>

      {uniqueCategories.length > 0 && (
        <PortfolioFilters
          categories={uniqueCategories}
          allLabel="Alle"
          client:idle
        />
      )}

      <PortfolioGrid
        projects={projects}
        baseUrl="/de/projekte"
        ctaText="Mehr ansehen"
        yearLabel="Jahr:"
      />
    </div>
  </section>
</Base>
