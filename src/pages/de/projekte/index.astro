---
import Base from "@/layouts/Base.astro";
import { getCollection } from "astro:content";

const lang = "de";

// Get projects collection for German
const allProjects = await getCollection("projects");
const projects = allProjects
  .filter((project) => project.id.startsWith("german/") && !project.data.draft)
  .sort((a, b) => (b.data.year || 0) - (a.data.year || 0));
---

<Base title="Unsere Projekte" lang={lang}>
  <section class="section">
    <div class="container">
      <h1 class="h2 mb-8">Unsere Projekte</h1>
      <div class="row">
        {
          projects.map((project) => (
            <div class="md:col-6 lg:col-4 mb-8">
              <div class="bg-light dark:bg-darkmode-light rounded overflow-hidden">
                <img
                  src={project.data.cover}
                  alt={project.data.title}
                  class="w-full h-64 object-cover"
                />
                <div class="p-6">
                  <h3 class="h4 mb-2">
                    <a href={`/de/projekte/${project.data.slug}`}>
                      {project.data.title}
                    </a>
                  </h3>
                  {project.data.year && (
                    <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
                      Jahr: {project.data.year}
                    </p>
                  )}
                  <a
                    href={`/de/projekte/${project.data.slug}`}
                    class="btn btn-primary btn-sm"
                  >
                    Mehr ansehen
                  </a>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Base>
