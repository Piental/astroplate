---
import Base from "@/layouts/Base.astro";
import { getCollection } from "astro:content";
import { render } from "astro:content";

const lang = "de";

export async function getStaticPaths() {
  const allProjects = await getCollection("projects");
  const germanProjects = allProjects.filter((project) =>
    project.id.startsWith("german/")
  );

  return germanProjects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Base title={project.data.title} lang={lang}>
  <section class="section pt-7">
    <div class="container">
      <div class="row justify-center">
        <article class="lg:col-10">
          {
            project.data.cover && (
              <div class="mb-10">
                <img
                  src={project.data.cover}
                  alt={project.data.title}
                  class="w-full rounded"
                />
              </div>
            )
          }
          <h1 class="h2 mb-4">{project.data.title}</h1>

          {project.data.year && (
            <div class="mb-6">
              <strong>Jahr:</strong> {project.data.year}
            </div>
          )}

          {project.data.materials && (
            <div class="mb-6">
              <strong>Materialien:</strong> {project.data.materials}
            </div>
          )}

          {project.data.time_to_complete && (
            <div class="mb-6">
              <strong>Fertigstellungszeit:</strong> {project.data.time_to_complete}
            </div>
          )}

          <div class="content mb-10">
            <Content />
          </div>

          {project.data.gallery && project.data.gallery.length > 0 && (
            <div class="mb-10">
              <h2 class="h4 mb-4">Galerie</h2>
              <div class="row">
                {project.data.gallery.map((image: string) => (
                  <div class="md:col-4 mb-4">
                    <img src={image} alt="Galerie" class="w-full rounded" />
                  </div>
                ))}
              </div>
            </div>
          )}

          <div class="mt-8">
            <a href="/de/projekte" class="btn btn-outline-primary">
              ← Zurück zu Projekten
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>
</Base>
