---
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ServicesGrid from "@/components/ServicesGrid.astro";
import SEOHead from "@/components/SEOHead.astro";
import { getCollection } from "astro:content";

const lang = "de";

// Get services collection for German
const allServices = await getCollection("services");
const services = allServices
  .filter((service) => service.id.startsWith("german/") && !service.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
---

<Base title="Unser Angebot" lang={lang}>
  <SEOHead
    slot="head"
    title="Unser Angebot - Maßmöbel"
    description="Wir bieten Maßmöbel an: Küchen, Schränke, Ankleidezimmer, Einbaumöbel. Hohe Qualität und individuelle Designs."
    lang={lang}
  />

  <div class="border-t border-border py-4 dark:border-darkmode-border">
    <div class="container">
      <Breadcrumbs className="text-sm" />
    </div>
  </div>
  <section class="section pt-14">
    <div class="container">
      <div class="text-center mb-12">
        <h1 class="h2 mb-4">Unser Angebot</h1>
        <p class="text-lg text-text dark:text-darkmode-text">
          Wir schaffen Maßmöbel nach Ihren Bedürfnissen
        </p>
      </div>
      <ServicesGrid
        services={services}
        baseUrl="/de/angebot"
        ctaText="Mehr erfahren"
      />
    </div>
  </section>
</Base>
