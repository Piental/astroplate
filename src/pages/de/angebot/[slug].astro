---
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import SEOHead from "@/components/SEOHead.astro";
import ImageMod from "@/components/ImageMod.astro";
import CallToActionComp from "@/components/CallToAction.astro";
import StickyCallButton from "@/components/StickyCallButton.astro";
import { getCollection } from "astro:content";
import { render } from "astro:content";

const lang = "de";

export async function getStaticPaths() {
  const allServices = await getCollection("services");
  const germanServices = allServices.filter((service) =>
    service.id.startsWith("german/")
  );

  return germanServices.map((service) => ({
    params: { slug: service.data.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const { Content } = await render(service);
---

<Base title={service.data.title} lang={lang}>
  <SEOHead
    slot="head"
    title={service.data.title}
    description={service.data.excerpt}
    image={service.data.image}
    lang={lang}
  />

  <div class="border-t border-border py-4 dark:border-darkmode-border">
    <div class="container">
      <Breadcrumbs className="text-sm" />
    </div>
  </div>
  <section class="section pt-14">
    <div class="container">
      <div class="row justify-center">
        <article class="lg:col-10">
          {
            service.data.image && (
              <div class="mb-10">
                <ImageMod
                  src={service.data.image}
                  alt={service.data.title}
                  width={1200}
                  height={600}
                  format="webp"
                  class="w-full rounded"
                />
              </div>
            )
          }
          <h1 class="h2 mb-4">{service.data.title}</h1>
          <div class="content mb-10">
            <Content />
          </div>
          <div class="mt-8">
            <a href="/de/angebot" class="btn btn-outline-primary">
              ← Zurück zum Angebot
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <CallToActionComp
    title="Interessiert an dieser Dienstleistung?"
    description="Kontaktieren Sie uns, um die Details Ihres Projekts zu besprechen"
    buttonText="Jetzt anrufen"
  />
  <StickyCallButton label="Anrufen" />
</Base>
