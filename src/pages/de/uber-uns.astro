---
import ImageMod from "@/components/ImageMod.astro";
import Base from "@/layouts/Base.astro";
import CallToActionComp from "@/components/CallToAction.astro";
import StickyCallButton from "@/components/StickyCallButton.astro";
import { getListPage } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import { render, type ContentEntryMap } from "astro:content";

const lang = "de";

const about = await getListPage("about", lang as keyof ContentEntryMap);
if (about[0].data.draft) {
  return Astro.redirect("/404");
}

const { Content } = await render(about[0]);
const { title, description, meta_title, image } = about[0].data;
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
  lang={lang}
>
  <section class="section-sm pt-14">
    <div class="container">
      <div class="row justify-center">
        <div class="md:col-10 lg:col-8">
          {
            image && (
              <ImageMod
                class="mx-auto mb-6 rounded"
                src={image}
                width={1200}
                height={600}
                alt={title}
                format="webp"
              />
            )
          }
          <h1 set:html={markdownify(title)} class="h2 mb-6" />
          <div class="content">
            <Content />
          </div>
        </div>
      </div>
    </div>
  </section>

  <CallToActionComp
    title="Haben Sie Fragen?"
    description="Kontaktieren Sie uns - wir beantworten gerne alle Ihre Fragen"
    buttonText="Jetzt anrufen"
  />
  <StickyCallButton label="Anrufen" />
</Base>
