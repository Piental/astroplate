---
interface Props {
  title?: string;
  description?: string;
  phone?: string;
  buttonText?: string;
}

const {
  title = "Skontaktuj się z nami",
  description = "Jesteśmy gotowi zrealizować Twój projekt!",
  phone = "+48 123 456 789",
  buttonText = "Zadzwoń teraz",
} = Astro.props;
---

<section class="section bg-primary dark:bg-darkmode-primary">
  <div class="container">
    <div class="row items-center justify-center text-center">
      <div class="lg:col-8">
        <h2 class="h2 mb-4 text-white">{title}</h2>
        <p class="mb-6 text-white text-lg">{description}</p>
        <a
          href={`tel:${phone.replace(/\s/g, "")}`}
          class="btn btn-outline-white inline-flex items-center gap-2"
        >
          <svg
            class="w-5 h-5"
            fill="currentColor"
            viewBox="0 0 20 20"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"
            ></path>
          </svg>
          {buttonText}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .btn-outline-white {
    border: 2px solid white;
    color: white;
    transition: all 0.3s ease;
  }

  .btn-outline-white:hover {
    background-color: white;
    color: var(--color-primary);
  }
</style>
