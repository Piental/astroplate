---
interface Props {
  embedUrl?: string;
  buttonText?: string;
  mapTitle?: string;
}

const {
  embedUrl = "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2443.162!2d21.0122!3d52.2297!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zNTLCsDEzJzQ3LjAiTiAyMcKwMDAnNDQuMCJF!5e0!3m2!1spl!2spl!4v1234567890",
  buttonText = "Pokaż mapę",
  mapTitle = "Nasza lokalizacja",
} = Astro.props;
---

<div class="map-embed-container" data-embed-url={embedUrl}>
  <button
    class="map-trigger-button"
    aria-label={buttonText}
    data-map-button
  >
    <svg
      class="w-6 h-6"
      fill="currentColor"
      viewBox="0 0 20 20"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        fillRule="evenodd"
        d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"
        clipRule="evenodd"></path>
    </svg>
    <span>{buttonText}</span>
  </button>
  <div class="map-placeholder hidden" data-map-container></div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const containers = document.querySelectorAll(".map-embed-container");
    
    containers.forEach((container) => {
      const button = container.querySelector("[data-map-button]");
      const mapContainer = container.querySelector("[data-map-container]");
      const embedUrl = container.getAttribute("data-embed-url");
      
      if (!button || !mapContainer || !embedUrl) return;
      
      button.addEventListener("click", () => {
        const iframe = document.createElement("iframe");
        iframe.src = embedUrl;
        iframe.width = "100%";
        iframe.height = "450";
        iframe.style.border = "0";
        iframe.allowFullscreen = true;
        iframe.loading = "lazy";
        iframe.referrerPolicy = "no-referrer-when-downgrade";
        
        mapContainer.innerHTML = "";
        mapContainer.appendChild(iframe);
        mapContainer.classList.remove("hidden");
        button.remove();
      });
    });
  });
</script>

<style>
  .map-embed-container {
    background-color: var(--color-light);
    border-radius: 0.5rem;
    overflow: hidden;
  }

  .dark .map-embed-container {
    background-color: var(--color-darkmode-light);
  }

  .map-trigger-button {
    width: 100%;
    height: 16rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    background-color: #e5e7eb;
    transition: all 0.3s;
    cursor: pointer;
    font-size: 1.125rem;
    font-weight: 600;
  }

  .map-trigger-button:hover {
    background-color: #d1d5db;
  }

  .dark .map-trigger-button {
    background-color: #374151;
  }

  .dark .map-trigger-button:hover {
    background-color: #4b5563;
  }

  .map-placeholder iframe {
    border-radius: 0.5rem;
  }
</style>
