---
interface Props {
  phone?: string;
  email?: string;
  address?: string;
  hours?: string;
  phoneLabel?: string;
  emailLabel?: string;
  addressLabel?: string;
  hoursLabel?: string;
}

const {
  phone = "+48 123 456 789",
  email = "kontakt@example.pl",
  address = "ul. Przykładowa 123, 00-000 Warszawa, Polska",
  hours = "Pn-Pt: 9:00-17:00, Sb: 10:00-14:00",
  phoneLabel = "Telefon",
  emailLabel = "Email",
  addressLabel = "Adres",
  hoursLabel = "Godziny otwarcia",
} = Astro.props;
---

<div class="bg-light dark:bg-darkmode-light rounded-lg p-8">
  <h3 class="h4 mb-6">Dane kontaktowe</h3>
  
  <div class="space-y-6">
    <div>
      <h4 class="font-bold mb-2 text-dark dark:text-darkmode-light">
        {phoneLabel}
      </h4>
      <a
        href={`tel:${phone.replace(/\s/g, "")}`}
        class="text-primary dark:text-darkmode-primary hover:underline flex items-center gap-2"
      >
        <svg
          class="w-5 h-5"
          fill="currentColor"
          viewBox="0 0 20 20"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"
          ></path>
        </svg>
        {phone}
      </a>
    </div>

    <div>
      <h4 class="font-bold mb-2 text-dark dark:text-darkmode-light">
        {emailLabel}
      </h4>
      <a
        href={`mailto:${email}`}
        class="text-primary dark:text-darkmode-primary hover:underline flex items-center gap-2"
      >
        <svg
          class="w-5 h-5"
          fill="currentColor"
          viewBox="0 0 20 20"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"
          ></path>
          <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"></path>
        </svg>
        {email}
      </a>
    </div>

    <div>
      <h4 class="font-bold mb-2 text-dark dark:text-darkmode-light">
        {addressLabel}
      </h4>
      <p class="flex items-start gap-2">
        <svg
          class="w-5 h-5 mt-1 flex-shrink-0"
          fill="currentColor"
          viewBox="0 0 20 20"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            fillRule="evenodd"
            d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"
            clipRule="evenodd"></path>
        </svg>
        {address}
      </p>
    </div>

    <div>
      <h4 class="font-bold mb-2 text-dark dark:text-darkmode-light">
        {hoursLabel}
      </h4>
      <p class="flex items-start gap-2">
        <svg
          class="w-5 h-5 mt-1 flex-shrink-0"
          fill="currentColor"
          viewBox="0 0 20 20"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            fillRule="evenodd"
            d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z"
            clipRule="evenodd"></path>
        </svg>
        {hours}
      </p>
    </div>
  </div>
</div>
