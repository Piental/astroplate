---
import { getLangFromUrl, getTranslations, slugSelector, supportedLang } from "@/lib/utils/languageParser";
import { humanize } from "@/lib/utils/textConverter";
import type { ContentEntryMap } from "astro:content";

const { className }: { className?: string } = Astro.props;

const pathSegments = Astro.url.pathname.split("/").filter((x) => x);

let pathPaths = [...pathSegments];
if (pathSegments.length > 0 && supportedLang.includes(pathSegments[0])) {
  pathPaths = pathSegments.slice(1);
}

const lang = getLangFromUrl(Astro.url);
const translations = await getTranslations(lang as keyof ContentEntryMap);

const homeLabel = translations?.home ?? "Home";

const parts: { label: string; href: string; "aria-label"?: string }[] = [
  {
    label: homeLabel,
    href: slugSelector("/", lang),
    "aria-label":
      pathPaths.length === 0 ? "page" : undefined,
  },
];

pathPaths.forEach((segment: string, i: number) => {
  if (segment === "page") return;
  const pathSoFar = "/" + pathPaths.slice(0, i + 1).join("/");
  const href = slugSelector(pathSoFar, lang);
  const i18nKey = segment.replace(".html", "").replace(/-/g, "_");
  const label =
    (translations && (translations as Record<string, string>)[i18nKey]) ??
    humanize(segment.replace(".html", "").replace(/[-_]/g, " ")) ??
    segment;
  const isCurrent =
    Astro.url.pathname.replace(/\/$/, "") === href.replace(/\/$/, "");
  parts.push({
    label,
    href,
    "aria-label": isCurrent ? "page" : undefined,
  });
});
---

<nav aria-label="Breadcrumb" class={className}>
  <ol class="inline-flex" role="list">
    {
      parts.map(({ label, ...attrs }, index) => (
        <li class="mx-1 capitalize" role="listitem">
          {index > 0 && <span class="inline-block mr-1">/</span>}
          {index !== parts.length - 1 ? (
            <a class="text-primary dark:text-darkmode-primary" {...attrs}>
              {label}
            </a>
          ) : (
            <span class="text-text-light dark:text-darkmode-text-light">
              {label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
