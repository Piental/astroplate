{
  "site": {
    "title": "Astroplate",
    "base_url": "https://astroplate-multilang.netlify.app",
    "base_path": "/",
    "trailing_slash": false,
    "favicon": "/images/image-placeholder.png",
    "logo": "/images/image-placeholder.png",
    "logo_darkmode": "/images/image-placeholder.png",
    "logo_width": "150",
    "logo_height": "30",
    "logo_text": "Astroplate"
  },

  "settings": {
    "sticky_header": true,
    "theme_switcher": true,
    "default_theme": "system",
    "default_language": "pl",
    "disable_languages": ["fr"],
    "default_language_in_subdir": false
  },

  "params": {
    "pl": {
      "contact_form_action": "#",
      "copyright": "© 2026 Pracownia Mebli na Wymiar. Wszelkie prawa zastrzeżone."
    },
    "en": {
      "contact_form_action": "#",
      "copyright": "© 2026 Custom Furniture Workshop. All rights reserved."
    },
    "de": {
      "contact_form_action": "#",
      "copyright": "© 2026 Möbelwerkstatt nach Maß. Alle Rechte vorbehalten."
    }
  },

  "google_tag_manager": {
    "enable": false,
    "gtm_id": "GTM-XXXXXX"
  },

  "metadata": {
    "meta_author": "zeon.studio",
    "meta_image": "/images/image-placeholder.png",
    "meta_description": "astro and tailwind boilerplate"
  }
}
